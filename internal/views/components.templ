package views

import (
	"fmt"
	"github.com/oexza/go-orisun-datastar/internal/resources"
)

templ Base(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script type="module" src={ resources.StaticPath("datastar.js") }></script>
			<link rel="stylesheet" href={ resources.StaticPath("style.css") }/>
		</head>
		<body>
			if isDevelopment() {
				<div data-init={ hotReloadSSE() }></div>
			}
			<div class="toast toast-top toast-center z-50 hidden" data-class:hidden="!$flashMessage">
				<div class="alert alert-error shadow-lg">
					<span data-text="$flashMessage"></span>
				</div>
			</div>
			{ children... }
		</body>
	</html>
}

templ AppNav(user User, active string) {
	<nav class="app-nav navbar">
		<div class="navbar-start">
			<a class="brand-link" href="/todos" aria-label="Go-Orisun-Datastar todos">
				<span class="brand-mark">G</span>
				<span class="brand-copy">
					<span class="brand-title">Go-Orisun-Datastar</span>
					<span class="brand-subtitle">Event-sourced starter</span>
				</span>
			</a>
		</div>
		<div class="navbar-end nav-actions">
			<div class="nav-tabs hidden sm:flex">
				<a class={ "nav-tab", templ.KV("active", active == "todos") } href="/todos">Todos</a>
				<a class={ "nav-tab", templ.KV("active", active == "profile") } href="/profile">Profile</a>
				<a class={ "nav-tab", templ.KV("active", active == "settings") } href="/profile/settings">Settings</a>
			</div>
			<div class="avatar placeholder hidden sm:flex">
				if user.Image != "" {
					<div class="avatar w-9 rounded-full">
						<img src={ user.Image } alt=""/>
					</div>
				} else {
					<div class="bg-neutral text-neutral-content w-9 rounded-full">
						<span class="text-xs font-bold">{ userInitials(user) }</span>
					</div>
				}
			</div>
			<form method="post" action="/logout">
				<button class="btn btn-outline btn-sm">Logout</button>
			</form>
		</div>
	</nav>
}

templ AuthForm(action string, title string, fields []Field, errors map[string]string) {
	<main id="auth-page" class="auth-layout">
		<section class="auth-intro">
			<a class="brand-link brand-link-large" href="/login">
				<span class="brand-mark">G</span>
				<span class="brand-copy">
					<span class="brand-title">Go-Orisun-Datastar</span>
					<span class="brand-subtitle">Orisun events, Datastar UI</span>
				</span>
			</a>
			<h1>Server-rendered flows that stay fast and auditable.</h1>
			<p>Commands append events, handlers project state, and Datastar streams the small UI changes that matter.</p>
		</section>
		<section class="auth-card card">
			<div class="card-body">
				<div class="form-header">
					<p class="eyebrow">Account</p>
					<h2>{ title }</h2>
				</div>
				if errors != nil && errors["error"] != "" {
					<div class="alert alert-error alert-soft">{ errors["error"] }</div>
				}
				<form class="auth-form" method="post" action={ action } data-on:submit={ postFormSSE(action) }>
					for _, field := range fields {
						<label class="form-field">
							<span class="font-semibold">{ field.Label }</span>
							<input class={ "input w-full", templ.KV("input-error", errors != nil && errors[field.Name] != "") } name={ field.Name } type={ field.Type } required/>
						</label>
						if errors != nil && errors[field.Name] != "" {
							<small class="text-error">{ errors[field.Name] }</small>
						}
					}
					<button class="btn btn-primary w-full" type="submit">{ title }</button>
				</form>
				<div class="auth-links">
					{ children... }
				</div>
			</div>
		</section>
	</main>
}

templ SseIndicator(signalName string) {
	<span class="loading loading-spinner loading-sm" data-class={ fmt.Sprintf("{'opacity-100': $%s, 'opacity-0': !$%s}", signalName, signalName) }></span>
}
