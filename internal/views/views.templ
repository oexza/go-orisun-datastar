package views

templ Login(errors map[string]string) {
	@Base("Login") {
		@LoginForm(errors)
	}
}

templ LoginForm(errors map[string]string) {
	@AuthForm("/login", "Login", []Field{
		{Name: "email", Type: "email", Label: "Email"},
		{Name: "password", Type: "password", Label: "Password"},
	}, errors) {
		<a href="/register">Create account</a>
		<a href="/forgot-password">Forgot password?</a>
	}
}

templ Register(errors map[string]string) {
	@Base("Register") {
		@RegisterForm(errors)
	}
}

templ RegisterForm(errors map[string]string) {
	@AuthForm("/register", "Create account", []Field{
		{Name: "username", Type: "text", Label: "Username"},
		{Name: "email", Type: "email", Label: "Email"},
		{Name: "password", Type: "password", Label: "Password"},
		{Name: "firstName", Type: "text", Label: "First name"},
		{Name: "lastName", Type: "text", Label: "Last name"},
		{Name: "yearOfBirth", Type: "number", Label: "Year of birth"},
	}, errors) {
		<a href="/login">Sign in</a>
	}
}

templ ForgotPassword(errors map[string]string) {
	@Base("Forgot password") {
		@ForgotPasswordForm(errors)
	}
}

templ ForgotPasswordForm(errors map[string]string) {
	@AuthForm("/forgot-password", "Forgot password", []Field{
		{Name: "email", Type: "email", Label: "Email"},
	}, errors) {
		<a href="/login">Back to login</a>
	}
}

templ ResetPassword(token string, errors map[string]string) {
	@Base("Reset password") {
		@ResetPasswordForm(token, errors)
	}
}

templ ResetPasswordForm(token string, errors map[string]string) {
	@AuthForm("/reset-password/" + token, "Reset password", []Field{
		{Name: "password", Type: "password", Label: "New password"},
	}, errors) {
	}
}

templ ValidateEmail(userID string, errors map[string]string) {
	@Base("Validate email") {
		@ValidateEmailForm(userID, errors)
	}
}

templ ValidateEmailForm(userID string, errors map[string]string) {
	@AuthForm("/register/" + userID + "/validate-email", "Validate email", []Field{
		{Name: "otp", Type: "text", Label: "Verification code"},
	}, errors) {
		<form class="w-full" data-on:submit={ sendValidationOTPSSE(userID) }>
			<button class="btn btn-outline w-full" type="submit">Send new code</button>
		</form>
	}
}

templ TodosPage(user User, todos []Todo) {
	@Base("Todos") {
		<main class="page">
			@AppNav(user, "todos")
			<section class="page-header">
				<h1 class="page-title">Todos</h1>
				<p class="page-subtitle">A compact event-sourced workflow powered by Orisun projections and Datastar fragments.</p>
			</section>
			<form class="todo-form" data-on:submit={ postFormSSE("/todos") } data-indicator="creatingTodo">
				<input class="input w-full" id="todo-title" name="title" data-bind:new-todo-title maxlength="160" required placeholder="Add a todo"/>
				<button class="btn btn-primary" type="submit">Add</button>
				@SseIndicator("creatingTodo")
			</form>
			<section id="todo-workspace" data-init={ longRunningGetSSE("/todos/stream") }>
				@TodoWorkspace(todos)
			</section>
		</main>
	}
}

templ TodoWorkspace(todos []Todo) {
	{{ stats := todoStats(todos) }}
	<section class="todo-summary" aria-label="Todo summary">
		<div class="todo-metric">
			<span>Total</span>
			<strong>{ todoCountLabel(stats.Total) }</strong>
		</div>
		<div class="todo-metric">
			<span>Active</span>
			<strong>{ todoCountLabel(stats.Active) }</strong>
		</div>
		<div class="todo-metric">
			<span>Done</span>
			<strong>{ todoCountLabel(stats.Completed) }</strong>
		</div>
		<div class="todo-progress" aria-label="Completion progress">
			<div>
				<span>Progress</span>
				<strong>{ todoCompletionLabel(stats) }</strong>
			</div>
			<div class="todo-progress-track">
				<div class="todo-progress-bar" style={ todoProgressStyle(stats) }></div>
			</div>
		</div>
	</section>
	<section class="todo-toolbar" aria-label="Todo bulk actions">
		if stats.Active > 0 {
			<form data-on:submit={ todoCompleteActiveSSE() }>
				<button class="btn btn-sm btn-outline" type="submit">Complete active</button>
			</form>
		} else {
			<button class="btn btn-sm btn-outline btn-disabled" type="button">Complete active</button>
		}
		if stats.Completed > 0 {
			<form data-on:submit={ todoReopenCompletedSSE() }>
				<button class="btn btn-sm btn-outline" type="submit">Reopen done</button>
			</form>
			<form data-on:submit={ todoClearCompletedSSE() }>
				<button class="btn btn-sm btn-ghost text-error" type="submit">Clear done</button>
			</form>
		} else {
			<button class="btn btn-sm btn-outline btn-disabled" type="button">Reopen done</button>
			<button class="btn btn-sm btn-ghost btn-disabled" type="button">Clear done</button>
		}
	</section>
	@TodoList(todos)
}

templ TodoList(todos []Todo) {
	if len(todos) == 0 {
		<div class="empty">
			<h2>No todos yet</h2>
			<p>Add the first item and the read model will update over SSE.</p>
		</div>
	} else {
		<div class="todo-list">
			for _, todo := range todos {
				@TodoRow(todo)
			}
		</div>
	}
}

templ TodoRow(todo Todo) {
	{{ class := "todo-row" }}
	if todo.Completed {
		{{ class = "todo-row completed" }}
	}
	<article class={ class }>
		<form data-on:submit={ todoToggleSSE(todo) }>
			<button class={ "todo-check", templ.KV("checked", todo.Completed) } aria-label="toggle todo completion">
			</button>
		</form>
		<form class="todo-title" data-on:submit={ todoRenameSSE(todo) }>
			<input class="todo-title-input input input-ghost w-full" name="title" value={ todo.Title } maxlength="160" required/>
			if todoTimeLabel(todo) != "" {
				<span class="todo-meta">{ todoTimeLabel(todo) }</span>
			}
		</form>
		<span class={ "todo-status", templ.KV("done", todo.Completed) }>
			if todo.Completed {
				Done
			} else {
				Active
			}
		</span>
		<form data-on:submit={ todoDeleteSSE(todo) }>
			<button class="btn btn-ghost btn-sm text-error" aria-label="Delete todo">Delete</button>
		</form>
	</article>
}

templ Profile(user User) {
	@Base("Profile") {
		<main class="page">
			@AppNav(user, "profile")
			<section id="profile-panel" data-init={ longRunningGetSSE("/profile/stream") }>
				@ProfilePanel(user)
			</section>
		</main>
	}
}

templ ProfilePanel(user User) {
	<section class="profile-hero">
		if user.HeaderImageURL != "" {
			<div class="profile-cover" style={ "background-image: linear-gradient(180deg, transparent, color-mix(in oklab, var(--color-neutral) 28%, transparent)), url('" + user.HeaderImageURL + "')" }></div>
		} else {
			<div class="profile-cover"></div>
		}
		<div class="profile-content">
			if user.Image != "" {
				<img class="profile-avatar" src={ user.Image } alt=""/>
			} else {
				<div class="profile-avatar profile-avatar-fallback">{ userInitials(user) }</div>
			}
			<div class="grid gap-1">
				<h1 class="text-3xl font-bold">{ displayName(user) }</h1>
				<p class="text-base-content/60">{ "@" + user.Username } · { user.Email }</p>
			</div>
			if user.Bio != "" {
				<p class="max-w-2xl text-lg leading-relaxed">{ user.Bio }</p>
			} else {
				<p class="text-base-content/50">No bio yet.</p>
			}
			<div>
				<a class="btn btn-primary" href="/profile/edit">Edit profile</a>
			</div>
		</div>
	</section>
}

templ ProfileEdit(user User, errors map[string]string) {
	@Base("Edit profile") {
		@ProfileEditPanel(user, errors)
	}
}

templ ProfileEditPanel(user User, errors map[string]string) {
	<main id="profile-edit-page" class="page">
		@AppNav(user, "profile")
		<section class="page-header">
			<h1 class="page-title">Edit profile</h1>
			<p class="page-subtitle">Update profile details through commands that publish profile events.</p>
		</section>
		<section class="settings-grid">
			<form class="stack-form panel" method="post" action="/profile/bio" data-on:submit={ postFormSSE("/profile/bio") }>
				<h2 class="text-lg font-bold">Bio</h2>
				if errors != nil && errors["bio"] != "" {
					<div class="alert alert-error alert-soft">{ errors["bio"] }</div>
				}
				<label class="grid gap-2">
					<span class="font-semibold">Bio</span>
					<textarea class="textarea min-h-32 w-full" name="bio" maxlength="280">{ user.Bio }</textarea>
				</label>
				<button class="btn btn-primary">Save bio</button>
			</form>
			<form class="stack-form panel" method="post" enctype="multipart/form-data" action="/profile/avatar">
				<h2 class="text-lg font-bold">Avatar</h2>
				<input class="file-input w-full" type="file" name="file" accept="image/*"/>
				<button class="btn btn-neutral">Upload avatar</button>
			</form>
			<form class="stack-form panel" method="post" enctype="multipart/form-data" action="/profile/header-image">
				<h2 class="text-lg font-bold">Header image</h2>
				<input class="file-input w-full" type="file" name="file" accept="image/*"/>
				<button class="btn btn-neutral">Upload header</button>
			</form>
		</section>
	</main>
}

templ Settings(user User) {
	@Base("Settings") {
		<main class="page">
			@AppNav(user, "settings")
			<section class="page-header">
				<h1 class="page-title">Settings</h1>
				<p class="page-subtitle">Account commands append events and update projections asynchronously.</p>
			</section>
			<section class="settings-grid">
				<form class="stack-form panel" data-on:submit={ postFormSSE("/user/name") }>
					<h2 class="text-lg font-bold">Display name</h2>
					<label class="grid gap-2">
						<span class="font-semibold">Name</span>
						<input class="input w-full" name="name" value={ user.Name } required/>
					</label>
					<button class="btn btn-primary">Save name</button>
				</form>
				<form class="stack-form panel" data-on:submit={ postFormSSE("/settings/change-password") }>
					<h2 class="text-lg font-bold">Password</h2>
					<label class="grid gap-2">
						<span class="font-semibold">Current password</span>
						<input class="input w-full" name="currentPassword" type="password" required/>
					</label>
					<label class="grid gap-2">
						<span class="font-semibold">New password</span>
						<input class="input w-full" name="newPassword" type="password" required/>
					</label>
					<button class="btn btn-neutral">Change password</button>
				</form>
			</section>
		</main>
	}
}
